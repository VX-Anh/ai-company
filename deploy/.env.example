# Sao chép thành deploy/.env (không commit file .env).
POSTGRES_PASSWORD=doi-mat-khau-nay
# Nơi chứa repo: github (mặc định) hoặc gitlab
GIT_PROVIDER=github
# Repo pilot, phân tách bằng dấu phẩy. GitHub: owner/repo. Khớp constraints.repos trong company/roles/*.yaml
GITLAB_PROJECTS=owner/pilot-repo
AICO_DEFAULT_PROJECT=owner/pilot-repo
# Chỉ cho GitLab
GITLAB_URL=
# 1 = dùng repo giả trong bộ nhớ để chạy thử, không cần token thật
GITLAB_FAKE=1
# Máy build từ xa (server compute, không giữ bí mật). Để trống thì aico-remote báo chưa cấu hình.
# Cần deploy/secrets/remote_ssh_key (khoá riêng cho runner) và remote_known_hosts
# (ssh-keyscan server); hai file phải tồn tại, để rỗng nếu chưa dùng.
REMOTE_SSH_TARGET=
# Repo được dựng bản xem trước khi có MR (http://localhost:8500/preview/), phân tách dấu phẩy
AICO_PREVIEW_PROJECTS=
# Tên miền qua Cloudflare Tunnel (README mục "Tên miền"). Bật: COMPOSE_PROFILES=tunnel
COMPOSE_PROFILES=
PREVIEW_PUBLIC_URL=http://localhost:8500
PREVIEW_HOSTS=
