  "cards": [
    {
      "dot": "rose",
      "title": "Ranh giới bảo mật",
      "items": [
        "Mọi tool call ra ngoài sandbox đều qua guard",
        "Sandbox chỉ có terminal, file editor; không credential, chỉ gọi được model relay và registry",
        "aico push branch và mở MR thay sandbox",
        "Guard áp quyền, ngân sách do Governance cấp; merge_mr đòi bản ghi duyệt",
        "Chỉ sandbox_launcher giữ quyền Docker (rootless)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Nền tảng",
      "items": [
        "Chạy bằng Docker Compose trong WSL2 trên máy Windows; Langfuse, Qdrant có thể đặt trên server",
        "Langfuse nhận trace workflow từ graph và trace model từ model relay",
        "Ticket có lease trong Postgres nên chạy tiếp được sau khi aico hoặc máy khởi động lại",
        "Model relay trong aico giữ key 9router, cấp token tạm theo task, thực thi ngân sách theo ticket"
      ]
    }
