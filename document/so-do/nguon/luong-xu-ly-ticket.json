  "cards": [
    {
      "dot": "rose",
      "title": "Hai điểm người duyệt",
      "items": [
        "Kế hoạch của ticket rủi ro medium, high",
        "Merge luôn cần người duyệt (hành động L3)"
      ]
    },
    {
      "dot": "amber",
      "title": "Mọi vòng đều có trần",
      "items": [
        "plan_rounds, review_rounds, merge_attempts có trần trong SOP",
        "Quá trần hoặc quá hạn duyệt thì escalate",
        "Lỗi kỹ thuật không phục hồi thì ticket chuyển failed"
      ]
    },
    {
      "dot": "cyan",
      "title": "Bền qua sự cố",
      "items": [
        "Mỗi điểm dừng là một checkpoint Postgres",
